# Vorschau mit Domain und automatischem HTTPS (Let's Encrypt).
# Aktivieren: in .env.preview setzen: CADDY_FILE=Caddyfile.tls, DOMAIN=<deine-domain>,
# COOKIE_SECURE=true, WEB_ORIGIN=https://<deine-domain>; DNS A/AAAA auf den Server, Ports 80+443 in der Hetzner-Firewall.

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	handle /ws {
		reverse_proxy chat-gateway:4100
	}

	# Messwerte nur intern (Prometheus), nie oeffentlich
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}

	handle {
		# Besucher-IP fuer das Web (Rate-Limit der oeffentlichen Seiten je IP). header_up ersetzt einen
		# vom Client mitgeschickten X-Real-IP, das Web liest nur diesen Header.
		reverse_proxy web:3000 {
			header_up X-Real-IP {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
