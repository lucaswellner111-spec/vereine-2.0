{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /ws {
		reverse_proxy chat-gateway:4100
	}

	# Messwerte nur intern (Prometheus), nie oeffentlich
	handle /api/metrics {
		respond 404
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header -Server
}
