# Vorlage fuer /etc/vereine/ops.env (Rechte 600, root). Enthaelt KEINE Geheimnisse:
# keine Passwoerter, keine Chat-/Auth-Schluessel, nur Pfade und Zugangsziele.
# Kopieren: install -m 600 infra/ops/ops.env.example /etc/vereine/ops.env

APP_DIR=/opt/vereine
COMPOSE_FILE=/opt/vereine/infra/deploy/docker-compose.preview.yml
ENV_FILE=/opt/vereine/.env.preview

# Sicherungen (lokal) und Statusdatei fuer den API-Container (nur Zeitpunkt/Groesse, keine Geheimnisse)
BACKUP_DIR=/var/backups/vereine
STATUS_DIR=/var/lib/vereine/status
MEDIA_VOLUME=deploy_mediadata

# Verschluesselung: NUR oeffentliche age-Schluessel (eine Zeile je Empfaenger, "age1...").
# Den privaten Schluessel (age-keygen) bewahrst du offline auf, nie auf dem Server.
AGE_RECIPIENTS=/etc/vereine/backup-recipients.txt

# Aufbewahrung (siehe docs/BETRIEB.md, Datenschutz: Backups enthalten geloeschte Daten bis Fristablauf)
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# Offsite auf Hetzner Storage Box (rsync ueber SSH, Port 23). Leer lassen = nur lokale Sicherung (nicht fuer Produktion!)
STORAGEBOX_TARGET=uXXXXXX@uXXXXXX.your-storagebox.de
STORAGEBOX_PORT=23
STORAGEBOX_DIR=vereine-backups
STORAGEBOX_KEY=/root/.ssh/storagebox_ed25519
STORAGEBOX_KNOWN_HOSTS=/root/.ssh/known_hosts_storagebox

# Pruefskript (check-backup.sh)
BACKUP_MAX_AGE_HOURS=30
BACKUP_MIN_BYTES=10240

# Uptime-Check (uptime-check.sh, am besten von einem ANDEREN Rechner aus laufen lassen)
UPTIME_URL=https://klubnest.de
UPTIME_CERT_MIN_DAYS=14
# Optional: Alarm-Mail per SMTP (Zugangsdaten nur hier, Datei 600)
# ALERT_SMTP_URL=smtps://smtp.tem.scw.cloud:465
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=
# ALERT_MAIL_FROM=
# ALERT_MAIL_TO=
