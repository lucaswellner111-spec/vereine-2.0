{
  "name": "@vereine/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "dev:pglite": "tsx dev/pglite-server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@vereine/shared": "*",
    "bullmq": "^6.5.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "postgres": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
