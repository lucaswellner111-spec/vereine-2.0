# Lokale Entwicklung - Kopie als .env anlegen (wird nicht eingecheckt)
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://vereine:vereine@localhost:5432/vereine
# Ohne REDIS_URL laeuft die API mit Prozess-Cache (nur lokal sinnvoll, nicht mit mehreren Servern)
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me
# Mail (vorbereitet, noch ohne Aufrufer): log = nichts versenden, nur Empfaenger-Domain/Vorlage/Laenge loggen
# smtp = Versand per SMTP mit STARTTLS (Port 587); dann sind SMTP_HOST, SMTP_USER, SMTP_PASS, MAIL_FROM Pflicht
MAIL_DRIVER=log
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Klubnest <noreply@example.org>"
